<Project Sdk="WixToolset.Sdk/6.0.2">

  <PropertyGroup>
    <OutputName>WtSetup</OutputName>
    <OutputType>Package</OutputType>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">$(DefineConstants);Debug</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Publishes WtProgram (single-file WindowTabs.exe) and exposes the publish folder as !(bindpath.WtProgram) -->
    <ProjectReference Include="..\WtProgram\WtProgram.fsproj" Publish="true" />
  </ItemGroup>

</Project>
